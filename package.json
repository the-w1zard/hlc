{
    "name": "@the-w1zard/hlc",
    "version": "1.0.1",
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "default": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "1": "git add .",
        "2": "git commit -m \"first commit\"",
        "3": "git pull",
        "4": "git push",
        "5": "npm version patch",
        "6": "git push",
        "7": "git push --tags",
        "8": "npm publish --access public",
        "build": "tsc",
        "dev": "rspack serve  --emitDeclarationOnly && rspack build",
        "check": "tsc --noEmit",
        "*": "pnpm update && npm run build && npm run 1 && npm run 2 && npm run 3 && npm run 4 && npm run 5 && npm run 6 && npm run 7 && npm run 8"
    },
    "devDependencies": {
        "@the-w1zard/alias_types": "^1.0.19",
        "@tsconfig/node-lts": "^24.0.1",
        "@types/node": "^24.19.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {}
}
